{"eq_name": "feynman-i.37.4", "num_vars": 3, "function_set": ["exp", "log", "sqrt", "add", "sub", "mul", "div", "inv", "sin", "cos", "const"], "eq_expression": "[('add', 'binary'), ('X_0', 'var'), ('add', 'binary'), ('X_1', 'var'), ('mul', 'binary'), (2, 'const'), ('mul', 'binary'), ('pow', 'binary'), ('mul', 'binary'), ('X_0', 'var'), ('X_1', 'var'), (1/2, 'const'), ('cos', 'unary'), ('X_2', 'var')]", "expr": "X_0 + X_1 + 2*sqrt(X_0*X_1)*cos(X_2)"}