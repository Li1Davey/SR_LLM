{"eq_name": "feynman-bonus.17", "num_vars": 6, "function_set": ["exp", "log", "sqrt", "add", "sub", "mul", "div", "inv", "sin", "cos", "const"], "eq_expression": "[('mul', 'binary'), (1/2, 'const'), ('mul', 'binary'), ('pow', 'binary'), ('X_0', 'var'), (-1, 'const'), ('add', 'binary'), ('pow', 'binary'), ('X_1', 'var'), (2, 'const'), ('mul', 'binary'), ('pow', 'binary'), ('X_0', 'var'), (2, 'const'), ('mul', 'binary'), ('pow', 'binary'), ('X_2', 'var'), (2, 'const'), ('mul', 'binary'), ('pow', 'binary'), ('X_3', 'var'), (2, 'const'), ('add', 'binary'), (1, 'const'), ('mul', 'binary'), ('X_3', 'var'), ('mul', 'binary'), ('X_4', 'var'), ('pow', 'binary'), ('X_5', 'var'), (-1, 'const')]", "expr": "(X_0**2*X_2**2*X_3**2*(X_3*X_4/X_5 + 1) + X_1**2)/(2*X_0)"}